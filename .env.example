# Copy to .env and fill in whatever you actually need - .env is gitignored.
# See README.md's "LLM provider setup" section for full details. Nothing
# here is required if you're only using --provider ollama (the default)
# or --provider fake.

# Required only for --provider anthropic - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the Claude model used (defaults to AnthropicProvider.DEFAULT_MODEL)
ANTHROPIC_MODEL=

# Optional: default provider ("ollama", "anthropic", or "fake") - a --provider flag overrides this
BOOKRAG_PROVIDER=

# Optional: override the Ollama model/host used (defaults to OllamaProvider.DEFAULT_MODEL / localhost)
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# Optional: relocate the library/incoming-books directories (default: data/library, data/incoming)
BOOKRAG_LIBRARY_ROOT=
BOOKRAG_INCOMING_ROOT=
