# Copy to .env and fill in whatever you actually need - .env is gitignored.
# See README.md's "LLM provider setup" section for full details. Nothing
# here is required if you're only using --provider ollama (the default)
# or --provider fake.

# Required only for --provider anthropic - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the Claude model used (defaults to AnthropicProvider.DEFAULT_MODEL)
ANTHROPIC_MODEL=

# Optional: default provider ("ollama", "anthropic", or "fake") - a --provider flag overrides this
BOOKRAG_PROVIDER=

# Optional: override the Ollama model/host used (defaults to OllamaProvider.DEFAULT_MODEL / localhost)
OLLAMA_MODEL=
# Optional: override just the chat-answering model, independent of OLLAMA_MODEL above
# (defaults to OllamaProvider.DEFAULT_ANSWER_MODEL)
OLLAMA_ANSWER_MODEL=
# Optional: override the context window size used when ANSWERING (bookrag chat), defaults to
# OllamaProvider.DEFAULT_NUM_CTX. This also sizes the KV cache, so it is the main lever on how
# much VRAM a model needs - see README's "GPU or CPU" section.
OLLAMA_NUM_CTX=
# Optional: the CEILING on the context window used when EXTRACTING, defaults to
# OllamaProvider.DEFAULT_EXTRACT_NUM_CTX. Separate from OLLAMA_NUM_CTX above because chat and
# extraction send very differently sized prompts. You rarely need this: `bookrag extract`
# already picks a window from the book's own longest chapter and prints what it chose, and it
# only ever goes BELOW this ceiling, never above. Set it to force a smaller one.
OLLAMA_EXTRACT_NUM_CTX=
# Optional: force how many model layers Ollama puts on the GPU. Leave blank to let Ollama
# decide from actual free VRAM, which is almost always right. Set it only to override a
# conservative estimate when a full offload nearly fits; 0 forces CPU. Asking for more than
# fits fails with an out-of-memory error rather than falling back.
OLLAMA_NUM_GPU=
OLLAMA_BASE_URL=

# Optional: relocate the library/incoming-books directories (default: data/library, data/incoming)
BOOKRAG_LIBRARY_ROOT=
BOOKRAG_INCOMING_ROOT=
